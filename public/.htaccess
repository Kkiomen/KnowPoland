<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # The live domain only: https, without www. The application does the same
    # for every page, this also covers images and other static files. The
    # checks on HTTPS and X-Forwarded-Proto stop a redirect loop when TLS ends
    # at a proxy in front of the server, such as Cloudflare.
    RewriteCond %{HTTP_HOST} ^(www\.)?knowpoland\.com$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{ENV:HTTPS} !=on
    RewriteRule ^ https://knowpoland.com%{REQUEST_URI} [L,R=301]

    RewriteCond %{HTTP_HOST} ^www\.knowpoland\.com$ [NC]
    RewriteRule ^ https://knowpoland.com%{REQUEST_URI} [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# The server sent AVIF files with no content type at all. Browsers mostly
# sniff their way past that, but a declared type is the reliable way.
<IfModule mod_mime.c>
    AddType image/avif .avif
</IfModule>

# Every script and stylesheet the site loads comes from build/assets, whose
# file names carry a hash of their content: a new build is a new address, so
# the old file can be kept for a year. Photographs change rarely and are kept
# for a month.
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(avif|jpe?g|png|svg|webp|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>
